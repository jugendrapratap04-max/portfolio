# Copy this file to ".env.local" and fill in what you need. All values are OPTIONAL.

# Public site URL (used for SEO canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# EmailJS (contact form). Get these from https://www.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
